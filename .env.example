# 仅在本地 .env.local 中填写真实密钥；不要提交 .env.local。
ARK_API_KEY=

# 可选。不填写时默认使用 Seedream 5.0 Pro。
ARK_MODEL_ID=doubao-seedream-5-0-pro-260628

# 图层分离使用 Seedream 5.0 Pro 的 ImageGenerations 独立开关 layer_decomposition。
# 以下变量均可选；默认复用上方的 ARK_API_KEY、ARK_MODEL_ID 和官方方舟地址。
LAYER_SEPARATION_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
LAYER_SEPARATION_API_KEY=
LAYER_SEPARATION_MODEL=
